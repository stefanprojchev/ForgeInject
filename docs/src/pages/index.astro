---
import BaseLayout from "../layouts/BaseLayout.astro";
import CodeBlock from "../components/CodeBlock.astro";
import GitHubIcon from "../components/GitHubIcon.astro";
import ForgeLine from "../components/ForgeLine.astro";
import { siteConfig, resolveHref } from "../config";
import { forgePackages } from "../forge-ecosystem";
---

<BaseLayout>
  <main class="mx-auto max-w-6xl px-6">
    <!-- Hero -->
    <section class="relative pt-24 pb-0 text-center sm:pt-32">
      <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-border bg-card/80 px-3 py-1 backdrop-blur-sm">
        <span class="font-mono text-xs text-muted-foreground">Swift Package</span>
        <span class="rounded-full bg-orange-500/15 px-1.5 py-0.5 font-mono text-[10px] font-medium text-orange-600 dark:text-amber-400">v1.0.0</span>
      </div>

      <h1 class="mb-4 text-4xl font-bold tracking-tight text-foreground sm:text-5xl lg:text-6xl">
        ForgeInject
      </h1>

      <div class="mb-5">
        <ForgeLine />
      </div>

      <p class="mx-auto mb-8 max-w-md text-base text-muted-foreground">
        Macro-based dependency injection for iOS.<br />
        Constructor injection. Lazy resolution. Zero boilerplate.
      </p>

      <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={resolveHref("docs/getting-started")}
          class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-orange-600 px-5 py-2.5 text-sm font-medium text-white shadow-lg shadow-orange-600/15 transition-all hover:shadow-orange-600/25 hover:brightness-110 dark:bg-amber-500 dark:text-neutral-950 dark:shadow-amber-500/15 dark:hover:shadow-amber-500/25 sm:w-auto"
        >
          Get Started
          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a
          href={siteConfig.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-border bg-card/80 px-5 py-2.5 text-sm font-medium text-foreground backdrop-blur-sm transition-colors hover:bg-accent sm:w-auto"
        >
          <GitHubIcon />
          GitHub
        </a>
      </div>

    </section>

    <!-- Install snippet — centered between hero and content -->
    <div class="mx-auto my-16 w-fit">
      <div class="flex items-center gap-3 rounded-lg border border-border bg-card/80 py-3 pl-4 pr-5 font-mono text-xs backdrop-blur-sm whitespace-nowrap sm:text-sm">
        <span class="text-orange-500 dark:text-amber-400">$</span>
        <code class="text-muted-foreground">.package(url: <span class="text-foreground">"...ForgeInject"</span>, from: <span class="text-foreground">"1.0.0"</span>)</code>
      </div>
    </div>

    <!-- Code example -->
    <section class="mx-auto max-w-2xl pb-20">
      <h2 class="mb-6 text-center text-xs font-medium uppercase tracking-widest text-muted-foreground font-mono">Quick Example</h2>
      <CodeBlock code={`import ForgeInject

// 1. Register dependencies
struct AppDependencies: ForgeRegisterProtocol {
    func registerDependencies(in container: ForgeContainerProtocol) {
        container.register(with: .singleton) { _ in
            NetworkService() as NetworkServiceProtocol
        }
    }
}

// 2. Set up at app launch
let container = ForgeContainer()
AppDependencies().registerDependencies(in: container)
ForgeContainer.shared = container

// 3. Use @Injectable for constructor injection — testable by default
@Injectable
@Observable
final class ProfileViewModel {
    let network: NetworkServiceProtocol

    func load() async {
        let data = try? await network.fetch(from: profileURL)
    }
}

// Production: zero-arg init resolves from the container
let vm = ProfileViewModel()

// Tests: pass a mock directly — no container touching
let vm = ProfileViewModel(network: MockNetworkService())`} title="main.swift" />
    </section>

    <!-- Forge Ecosystem -->
    <section class="pb-24">
      <h2 class="mb-10 text-center text-xs font-medium uppercase tracking-widest text-muted-foreground font-mono">Forge Ecosystem</h2>
      <div class="mx-auto grid max-w-3xl gap-5 sm:grid-cols-2">
        {forgePackages.map((pkg, i) => {
          const isCurrent = pkg.name === siteConfig.name;
          const delay = `${i * 0.05}s`;
          return isCurrent ? (
            <div class="feature-card group relative overflow-hidden rounded-xl border border-amber-400/30 bg-card/60 backdrop-blur-sm" style={`animation-delay: ${delay};`}>
              <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-amber-400/40 to-transparent" />
              <div class="p-6">
                <div class="mb-2 flex items-center gap-3">
                  <div class="flex size-7 items-center justify-center rounded-md bg-orange-500/10 font-mono text-xs font-semibold text-orange-600 dark:bg-amber-400/10 dark:text-amber-400">{pkg.abbrev}</div>
                  <h3 class="text-sm font-semibold text-amber-400">{pkg.name}</h3>
                  <span class="rounded-full bg-amber-400/10 px-1.5 py-0.5 font-mono text-[10px] text-amber-400">current</span>
                </div>
                <p class="text-[13px] leading-relaxed text-muted-foreground">{pkg.description}</p>
              </div>
            </div>
          ) : (
            <a href={pkg.url} class="feature-card group relative overflow-hidden rounded-xl border border-border bg-card/60 backdrop-blur-sm transition-all duration-300 hover:border-amber-400/40 hover:bg-card/80" style={`animation-delay: ${delay};`}>
              <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-amber-400/0 to-transparent transition-all duration-500 group-hover:via-amber-400/60" />
              <div class="p-6">
                <div class="mb-2 flex items-center gap-3">
                  <div class="flex size-7 items-center justify-center rounded-md bg-orange-500/10 font-mono text-xs font-semibold text-orange-600 dark:bg-amber-400/10 dark:text-amber-400">{pkg.abbrev}</div>
                  <h3 class="text-sm font-semibold text-foreground">{pkg.name}</h3>
                </div>
                <p class="text-[13px] leading-relaxed text-muted-foreground">{pkg.description}</p>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Features -->
    <section class="pb-24">
      <h2 class="mb-10 text-center text-xs font-medium uppercase tracking-widest text-muted-foreground font-mono">Why ForgeInject</h2>
      <div class="grid gap-5 sm:grid-cols-3">
        <!-- @Injectable -->
        <div class="feature-card group relative overflow-hidden rounded-xl border border-border bg-card/60 backdrop-blur-sm transition-all duration-300 hover:border-amber-400/40 hover:bg-card/80" style="animation-delay: 0s;">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-amber-400/0 to-transparent transition-all duration-500 group-hover:via-amber-400/60" />
          <div class="p-6">
            <div class="mb-4 flex items-center gap-3">
              <span class="font-mono text-xl font-bold text-amber-400">@</span>
              <h3 class="text-sm font-semibold text-foreground">Constructor Injection</h3>
            </div>
            <div class="rounded-lg bg-[#0d1117] p-3 font-mono text-[12px] leading-relaxed space-y-0.5">
              <div><span class="text-[#ff7b72]">@Injectable</span></div>
              <div><span class="text-[#ff7b72]">final class</span> <span class="text-[#d2a8ff]">ViewModel</span> <span class="text-[#c9d1d9]">{"{"}</span></div>
              <div>  <span class="text-[#ff7b72]">let</span> <span class="text-[#d2a8ff]">api</span><span class="text-[#c9d1d9]">:</span> <span class="text-[#79c0ff]">APIClient</span></div>
              <div><span class="text-[#c9d1d9]">{"}"}</span></div>
            </div>
            <p class="mt-3 text-[13px] leading-relaxed text-muted-foreground">
              <code>@Injectable</code> generates a testable init with defaults resolved from the container.
            </p>
          </div>
        </div>

        <!-- Retain Policies -->
        <div class="feature-card group relative overflow-hidden rounded-xl border border-border bg-card/60 backdrop-blur-sm transition-all duration-300 hover:border-amber-400/40 hover:bg-card/80" style="animation-delay: 0.1s;">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-amber-400/0 to-transparent transition-all duration-500 group-hover:via-amber-400/60" />
          <div class="p-6">
            <div class="mb-4 flex items-center gap-3">
              <span class="font-mono text-xl font-bold text-amber-400">{"{ }"}</span>
              <h3 class="text-sm font-semibold text-foreground">Retain Policies</h3>
            </div>
            <div class="rounded-lg bg-[#0d1117] p-3 font-mono text-[12px] leading-relaxed space-y-0.5">
              <div><span class="text-[#c9d1d9]">.</span><span class="text-[#79c0ff]">transient</span>  <span class="text-[#8b949e]">// new each time</span></div>
              <div><span class="text-[#c9d1d9]">.</span><span class="text-[#79c0ff]">singleton</span>  <span class="text-[#8b949e]">// shared forever</span></div>
              <div><span class="text-[#c9d1d9]">.</span><span class="text-[#79c0ff]">weak</span>       <span class="text-[#8b949e]">// auto-released</span></div>
            </div>
            <p class="mt-3 text-[13px] leading-relaxed text-muted-foreground">
              Choose the right lifetime per dependency.<br />Fine-grained control over memory.
            </p>
          </div>
        </div>

        <!-- Swift 6 Concurrency -->
        <div class="feature-card group relative overflow-hidden rounded-xl border border-border bg-card/60 backdrop-blur-sm transition-all duration-300 hover:border-amber-400/40 hover:bg-card/80" style="animation-delay: 0.2s;">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-amber-400/0 to-transparent transition-all duration-500 group-hover:via-amber-400/60" />
          <div class="p-6">
            <div class="mb-4 flex items-center gap-3">
              <span class="font-mono text-xl font-bold text-amber-400">&lt;/&gt;</span>
              <h3 class="text-sm font-semibold text-foreground">Swift 6 Ready</h3>
            </div>
            <div class="rounded-lg bg-[#0d1117] p-3 font-mono text-[12px] leading-relaxed space-y-0.5">
              <div><span class="text-[#8b949e]">// Strict concurrency</span></div>
              <div><span class="text-[#ff7b72]">OSAllocatedUnfairLock</span></div>
              <div><span class="text-[#ff7b72]">@Sendable</span> <span class="text-[#79c0ff]">builders</span></div>
            </div>
            <p class="mt-3 text-[13px] leading-relaxed text-muted-foreground">
              Built on <code>OSAllocatedUnfairLock</code>. Resolve safely from any actor or isolation context.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .feature-card {
    animation: card-enter 0.5s ease-out both;
  }

  @keyframes card-enter {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-card {
      animation: none;
      opacity: 1;
    }
  }
</style>
