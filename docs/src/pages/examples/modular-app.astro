import DocsLayout from "../../layouts/DocsLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import PageNavigation from "../../components/PageNavigation.astro";

const networkModuleCode = `import Foundation
import ForgeInject

protocol HTTPClientProtocol {
    func data(from url: URL) async throws -> (Data, URLResponse)
}

extension URLSession: HTTPClientProtocol {}

protocol APIClientProtocol {
    func get<T: Decodable>(path: String) async throws -> T
}

final class APIClient: APIClientProtocol {
    private let http: HTTPClientProtocol
    private let baseURL: URL
    private let decoder = JSONDecoder()

    init(http: HTTPClientProtocol, baseURL: URL) {
        self.http = http
        self.baseURL = baseURL
    }

    func get<T: Decodable>(path: String) async throws -> T {
        let url = baseURL.appendingPathComponent(path)
        let (data, _) = try await http.data(from: url)
        return try decoder.decode(T.self, from: data)
    }
}

struct NetworkModule: ForgeRegisterProtocol {
    func registerDependencies(in container: ForgeContainerProtocol) {
        container.register(with: .singleton) { _ in
            URLSession.shared as HTTPClientProtocol
        }

        container.register(with: .singleton) { container in
            let http: HTTPClientProtocol = try container.resolve()
            return APIClient(
                http: http,
                baseURL: URL(string: "https://api.example.com")!
            ) as APIClientProtocol
        }
    }
}`;

const authModuleCode = `import Foundation
import ForgeInject

protocol TokenStorageProtocol {
    func save(token: String) throws
    func load() throws -> String?
    func clear() throws
}

protocol AuthServiceProtocol {
    var isAuthenticated: Bool { get }
    func signIn(email: String, password: String) async throws
    func signOut()
}

final class TokenStorage: TokenStorageProtocol {
    private var token: String?

    func save(token: String) throws { self.token = token }
    func load() throws -> String? { token }
    func clear() throws { token = nil }
}

final class AuthService: AuthServiceProtocol {
    private let api: APIClientProtocol
    private let storage: TokenStorageProtocol

    var isAuthenticated: Bool {
        (try? storage.load()) != nil
    }

    init(api: APIClientProtocol, storage: TokenStorageProtocol) {
        self.api = api
        self.storage = storage
    }

    func signIn(email: String, password: String) async throws {
        let response: TokenResponse = try await api.get(path: "/auth/sign-in")
        try storage.save(token: response.accessToken)
    }

    func signOut() {
        try? storage.clear()
    }
}

private struct TokenResponse: Decodable {
    let accessToken: String
}

struct AuthModule: ForgeRegisterProtocol {
    func registerDependencies(in container: ForgeContainerProtocol) {
        container.register(with: .singleton) { _ in
            TokenStorage() as TokenStorageProtocol
        }

        container.register(with: .singleton) { container in
            let api: APIClientProtocol = try container.resolve()
            let storage: TokenStorageProtocol = try container.resolve()
            return AuthService(
                api: api,
                storage: storage
            ) as AuthServiceProtocol
        }
    }
}`;

const userModuleCode = `import Foundation
import ForgeInject

struct User: Identifiable, Codable {
    let id: UUID
    let name: String
    let email: String
}

protocol UserRepositoryProtocol {
    func fetchCurrentUser() async throws -> User
}

final class UserRepository: UserRepositoryProtocol {
    private let api: APIClientProtocol
    private let auth: AuthServiceProtocol

    init(api: APIClientProtocol, auth: AuthServiceProtocol) {
        self.api = api
        self.auth = auth
    }

    func fetchCurrentUser() async throws -> User {
        guard auth.isAuthenticated else {
            throw URLError(.userAuthenticationRequired)
        }
        return try await api.get(path: "/me")
    }
}

struct UserModule: ForgeRegisterProtocol {
    func registerDependencies(in container: ForgeContainerProtocol) {
        container.register(with: .singleton) { container in
            let api: APIClientProtocol = try container.resolve()
            let auth: AuthServiceProtocol = try container.resolve()
            return UserRepository(api: api, auth: auth) as UserRepositoryProtocol
        }
    }
}`;

const appEntryCode = `import SwiftUI
import ForgeInject

struct AppDependencies: ForgeRegisterProtocol {
    func registerDependencies(in container: ForgeContainerProtocol) {
        NetworkModule().registerDependencies(in: container)
        AuthModule().registerDependencies(in: container)
        UserModule().registerDependencies(in: container)
    }
}

@main
struct TaskFlowApp: App {
    init() {
        let container = ForgeContainer()
        AppDependencies().registerDependencies(in: container)
        ForgeContainer.shared = container
    }

    var body: some Scene {
        WindowGroup {
            ContentView()
        }
    }
}`;
---

<DocsLayout title="Modular App" section="examples">
  <h1>Modular App</h1>
  <p class="text-lg text-muted-foreground mt-1 mb-8">Multi-module dependency registration with a root composition struct.</p>

  <h2>Network Module</h2>
  <p>Owns <code>HTTPClient</code> and <code>APIClient</code>. Other modules depend on <code>APIClientProtocol</code> without knowing the implementation details.</p>
  <CodeBlock code={networkModuleCode} title="NetworkModule.swift" />

  <h2>Auth Module</h2>
  <p>Registers <code>TokenStorage</code> and <code>AuthService</code>. The auth service depends on <code>APIClientProtocol</code> from the network module and <code>TokenStorageProtocol</code> from its own module. Cross-module dependencies resolve transparently through the shared container.</p>
  <CodeBlock code={authModuleCode} title="AuthModule.swift" />

  <h2>User Module</h2>
  <p>Registers <code>UserRepository</code>, which depends on both <code>APIClientProtocol</code> from the network module and <code>AuthServiceProtocol</code> from the auth module.</p>
  <CodeBlock code={userModuleCode} title="UserModule.swift" />

  <h2>App Entry Point</h2>
  <p>A root <code>AppDependencies</code> struct composes all feature modules. The app entry point only ever calls this one struct.</p>
  <CodeBlock code={appEntryCode} title="TaskFlowApp.swift" />

