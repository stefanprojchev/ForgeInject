---
import DocsLayout from "../../layouts/DocsLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import PageNavigation from "../../components/PageNavigation.astro";

const injectableUsage = `@Injectable
final class UserViewModel {
    let database: Database
    let analytics: AnalyticsService
}`;

const injectableExpansion = `// What the macro expands to
final class UserViewModel {
    let database: Database
    let analytics: AnalyticsService

    init(
        database: Database = try! ForgeContainer.shared!.resolve(),
        analytics: AnalyticsService = try! ForgeContainer.shared!.resolve()
    ) {
        self.database = database
        self.analytics = analytics
    }
}`;

const injectableTesting = `// Production call site stays zero-arg
let vm = UserViewModel()

// Tests swap dependencies without touching the container
let vm = UserViewModel(
    database: MockDatabase(),
    analytics: MockAnalytics()
)`;

const injectLazy = `final class ImageProcessor {
    // Lazy — resolved on first access, cached afterwards
    @Inject var filterEngine: FilterEngine

    func process(_ image: UIImage) -> UIImage {
        filterEngine.apply(.blur, to: image)
    }
}`;

const injectEager = `final class Logger {
    // Eager — resolved when the enclosing object initializes
    @Inject(lazy: false) var analytics: AnalyticsService
}`;

const injectExpansion = `// Lazy expansion — Mutex-backed, thread-safe check-then-set
private let _filterEngine = Mutex<FilterEngine?>(nil)
var filterEngine: FilterEngine {
    _filterEngine.withLock { storage in
        if let value = storage { return value }
        let value: FilterEngine = try! ForgeContainer.shared!.resolve()
        storage = value
        return value
    }
}`;

const freestandingUsage = `// In a let property
struct UserService: Sendable {
    let database: Database = #inject()
}

// Inside a lazy var for opt-in laziness
final class Worker {
    lazy var heavy: HeavyService = #inject()
}

// In a function body
func handleRequest() {
    let logger: Logger = #inject()
    logger.info("processing")
}`;

const comparisonMatrix = `┌────────────────┬───────────────┬─────────────┬──────────────┐
│                │ @Injectable   │ @Inject     │ #inject()    │
├────────────────┼───────────────┼─────────────┼──────────────┤
│ When resolved  │ init time     │ first access│ where used   │
│ Testable via   │ init params   │ container   │ surrounding  │
│                │               │             │ scope        │
│ Zero runtime   │ ✓             │ ✗ (Mutex)   │ ✓            │
│ overhead       │               │             │              │
│ Works in       │ class/struct/ │ class/actor │ anywhere a   │
│                │ actor         │ properties  │ value goes   │
│ Lazy?          │ ✗             │ ✓ (default) │ via lazy var │
└────────────────┴───────────────┴─────────────┴──────────────┘`;

const togetherExample = `@Injectable
final class UserViewModel {
    // Always-needed deps → constructor injection, fail-fast, testable
    let database: Database
    let analytics: AnalyticsService

    // Heavy / late-bootstrapped → lazy via @Inject
    @Inject var imageProcessor: ImageProcessor
    @Inject var experimentalFeature: ExperimentalService

    func loadAvatar() async {
        // Local-scope resolution via #inject()
        let logger: Logger = #inject()
        logger.info("loading avatar")

        let processed = await imageProcessor.process(...)
    }
}`;
---

<DocsLayout title="Macros" section="docs">
  <h1>Macros</h1>
  <p class="text-lg text-muted-foreground mt-1 mb-8">ForgeInject ships three macros. Pick the one that matches how you want each dependency resolved.</p>

  <h2>@Injectable — Constructor Injection</h2>
  <p>Apply <code>@Injectable</code> to any class, struct, or actor. The macro generates an <code>init</code> that takes every stored <code>let</code> property as a parameter, with default values resolved from <code>ForgeContainer.shared</code>.</p>
  <CodeBlock code={injectableUsage} />

  <h3>Expansion</h3>
  <CodeBlock code={injectableExpansion} />

  <h3>Testability</h3>
  <p>The generated init accepts explicit arguments, so tests can pass mocks directly — without touching the container at all.</p>
  <CodeBlock code={injectableTesting} />

  <p class="rounded-lg border border-border bg-muted/50 p-4 text-sm">
    <strong>What it skips:</strong> the macro ignores <code>var</code> properties, <code>static</code> properties, <code>let</code> properties with default values, and computed properties. Only plain stored <code>let</code> constants without defaults become init parameters.
  </p>

  <h2>@Inject — Lazy Properties</h2>
  <p>Apply <code>@Inject</code> to individual properties when you want lazy, cached resolution on first access. Use this for dependencies that may not always be needed, heavy services, or when the container isn't bootstrapped at init time.</p>
  <CodeBlock code={injectLazy} />

  <h3>Eager variant</h3>
  <p>Pass <code>lazy: false</code> to resolve at init time. No <code>Mutex</code> overhead, but less flexible — the container must be set before the containing object initializes.</p>
  <CodeBlock code={injectEager} />

  <h3>Expansion</h3>
  <p>The lazy form generates a <code>Mutex</code>-backed backing store plus a computed accessor. The lock serializes concurrent first-accesses so a single cached value is observed by every reader.</p>
  <CodeBlock code={injectExpansion} />

  <p class="rounded-lg border border-border bg-muted/50 p-4 text-sm">
    <strong>Why a Mutex:</strong> under Swift 6 strict concurrency, multiple tasks may race on first access. Without synchronization, two callers could both resolve and overwrite each other. The <code>Mutex&lt;T?&gt;</code> makes check-then-set atomic.
  </p>

  <h2>#inject() — Freestanding Expression</h2>
  <p>A freestanding macro that expands to a container resolution. Use it anywhere a value is expected — stored <code>let</code> properties, local variables, default parameters, or <code>lazy var</code> initializers.</p>
  <CodeBlock code={freestandingUsage} />

  <p class="rounded-lg border border-border bg-muted/50 p-4 text-sm">
    <strong>Why it's different:</strong> <code>@Injectable</code> and <code>@Inject</code> are attached to declarations — they can't be used on local variables, default parameters, or <code>let</code> properties inside structs. <code>#inject()</code> is the escape hatch for those scenarios.
  </p>

  <h2>When to Use Which</h2>
  <CodeBlock code={comparisonMatrix} />

  <div class="overflow-x-auto">
    <table>
      <thead>
        <tr>
          <th>Scenario</th>
          <th>Pick</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Typical view model, service, or repository with stable deps</td>
          <td><code>@Injectable</code></td>
        </tr>
        <tr>
          <td>Heavy dependency that may never be touched</td>
          <td><code>@Inject</code></td>
        </tr>
        <tr>
          <td>Breaking a circular dependency cycle</td>
          <td><code>@Inject</code> (lazy side)</td>
        </tr>
        <tr>
          <td>Local variable inside a function body</td>
          <td><code>#inject()</code></td>
        </tr>
        <tr>
          <td>Default parameter value</td>
          <td><code>#inject()</code></td>
        </tr>
        <tr>
          <td>Stored <code>let</code> in a <code>struct</code></td>
          <td><code>@Injectable</code> or <code>#inject()</code></td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>Combining Them</h2>
  <p>The macros compose freely. A typical view model uses <code>@Injectable</code> for its core deps, <code>@Inject</code> for optional or heavy ones, and <code>#inject()</code> for local scope.</p>
  <CodeBlock code={togetherExample} />

  <h2>Error Behavior</h2>
  <p>All three macros crash with <code>fatalError</code> if <code>ForgeContainer.shared</code> is not set or the requested type isn't registered. This is intentional — missing dependencies are programmer errors that should surface immediately during development, not be swallowed by optional chaining.</p>
  <p>If you need graceful failure handling, call <code>container.resolve()</code> directly and catch <code>ForgeContainerError</code>. See <a href="./registration#error-handling">Registration &rarr; Error Handling</a> for details.</p>

